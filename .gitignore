# Keep source datasets tracked for deployment.
# Generated/exported CSVs outside data/ should still be reviewed before commit.

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
backend/cache/

# Ignore Virtual Environments (if you create one later)
venv/
env/
.venv/

# Mac OS system files (if you or a collaborator uses a Mac)
.DS_Store
